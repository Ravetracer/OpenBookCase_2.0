# User-uploaded images only. Never execute or serve scripts from this directory,
# even if a crafted file ever lands here (defence in depth; uploads are re-encoded).
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .phar .pht
RemoveType .php .phtml .phar .pht
<FilesMatch "(?i)\.(php\d?|phtml|phar|pht|shtml|cgi|pl|py|sh|html?|svg)$|^\.">
    Require all denied
</FilesMatch>
